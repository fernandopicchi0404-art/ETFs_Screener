{
  "version": "2026-07-29",
  "description": "Fontes preferenciais de composição por ETF. Usado pelo plano de adapters (gestora → SEC). IDs iShares precisam ser confirmados no download real antes de produção.",
  "source_priority_default": ["sec_nport"],
  "adapters": {
    "vanguard_api": {
      "status": "validated",
      "endpoint_template": "https://investor.vanguard.com/investment-products/etfs/profile/api/{ticker_lower}/portfolio-holding/stock?start={start}&count={count}",
      "identifiers": ["isin", "cusip", "sedol", "ticker"],
      "notes": "Paginado. Testado jul/2026 para VT/VOO/VXUS/VEA/VWO/VGK/VPL/VTI/VYMI/VSS/VEU/VNQ/VNQI."
    },
    "ishares_csv": {
      "status": "validated",
      "endpoint_template": "https://www.ishares.com/us/products/{product_id}/{slug}/latest-holdings.csv",
      "identifiers": ["ticker", "name", "location", "exchange"],
      "notes": "Sem ISIN no CSV atual. product_id+slug precisam bater exatamente com a página do produto."
    },
    "spdr_xlsx": {
      "status": "partial",
      "endpoint_template": "https://www.ssga.com/library-content/products/fund-data/etfs/us/holdings-daily-us-en-{ticker_lower}.xlsx",
      "identifiers": ["cusip", "sedol", "ticker"],
      "notes": "SPY ok. RSP ainda sem URL confirmada."
    },
    "sec_nport": {
      "status": "implemented",
      "identifiers": ["isin", "cusip", "lei", "ticker"],
      "notes": "Fonte atual do pipeline."
    }
  },
  "etfs": {
